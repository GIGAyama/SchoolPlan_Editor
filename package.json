{
  "name": "schoolplan-editor-quality",
  "version": "1.0.0",
  "private": true,
  "description": "Quality gates for the SchoolPlan Editor Google Apps Script project",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-project.mjs",
    "gas:install": "npm install --no-save --no-package-lock --no-audit --no-fund @google/clasp@3.3.0",
    "gas:login": "node scripts/gas-deploy.mjs login",
    "gas:status": "node scripts/gas-deploy.mjs status",
    "gas:backup": "node scripts/gas-deploy.mjs backup",
    "gas:push": "node scripts/gas-deploy.mjs push",
    "deploy": "npm run quality && node scripts/gas-deploy.mjs deploy",
    "check:json": "node scripts/check-project.mjs --json",
    "check:self": "node scripts/check-project.mjs --self-test",
    "test": "node --test",
    "quality": "node tools/build-sw.mjs --check && npm run check && npm test",
    "build:vendor": "node tools/build-vendor.mjs",
    "build:vendor:qrcode": "node tools/build-vendor.mjs qrcode",
    "verify:icons": "node tools/verify-icons.mjs",
    "verify:print": "node tools/verify-print-fit.mjs",
    "verify:vendor-css": "node tools/compare-vendor-css.mjs",
    "demo:verify": "node tools/demo-video/verify-scenes.mjs",
    "demo:dry": "node tools/demo-video/record-demo.mjs --dry-run",
    "demo:record": "node tools/demo-video/record-demo.mjs",
    "build:sw": "node tools/build-sw.mjs",
    "build:fonts": "node tools/fonts/build-fonts.mjs"
  },
  "devDependencies": {
    "@material-symbols/font-400": "^0.45.10",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.11.3",
    "playwright": "^1.62.1",
    "qrcode-generator": "^2.0.4",
    "sweetalert2": "^11.14.5"
  }
}
